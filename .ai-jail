# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

command = ["claude"]
ro_maps = [
    "~/orca/projects/xtreme-system/.claude/settings.json",
    "~/orca/projects/xtreme-system/.claude/settings.local.json",
    "~/orca/projects/xtreme-system/.pylintrc",
    "~/orca/projects/xtreme-system/.env",
    "~/orca/projects/xtreme-system/.pre-commit-config.yaml",
    "~/orca/projects/xtreme-system/.github/workflows",
    "~/orca/projects/xtreme-system/CLAUDE.md",
    "~/orca/projects/xtreme-system/AGENTS.md",
]
