DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xtreme
AUTH_SECRET_KEY=changeme
LOG_LEVEL=INFO
LOG_JSON=false
# Origens permitidas em CORS (CSV). Em produção, liste as origens reais do frontend.
CORS_ORIGINS=http://localhost:8000
# Proxies confiaveis para X-Forwarded-For (CSV de IPs ou CIDRs).
# Vazio = ignora X-Forwarded-For e usa o IP do peer.
TRUSTED_PROXY_IPS=
# IPs/CIDRs autorizados pelo uvicorn a definir X-Forwarded-Proto/For.
# Em Docker atras de proxy, use a rede do proxy (ex.: 172.16.0.0/12).
FORWARDED_ALLOW_IPS=
