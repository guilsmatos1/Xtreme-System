DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xtreme
AUTH_SECRET_KEY=changeme
LOG_LEVEL=INFO
LOG_JSON=false
# Origens permitidas em CORS (CSV). Em produção, liste as origens reais do frontend.
CORS_ORIGINS=http://localhost:8000
# Proxies confiáveis para X-Forwarded-For (CSV de IPs ou CIDRs).
# Em Docker atrás de reverse proxy, normalmente use a rede bridge do proxy.
TRUSTED_PROXY_IPS=
# Proxies autorizados pelo uvicorn para X-Forwarded-Proto/Host.
# Deve acompanhar TRUSTED_PROXY_IPS quando houver reverse proxy.
FORWARDED_ALLOW_IPS=
