DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xtreme
# Opcional: usado se DATABASE_URL (ex.: container Docker) estiver inacessivel na
# inicializacao. Ex.: postgres local via brew, sem senha.
# DATABASE_URL_FALLBACK=postgresql+psycopg://postgres@localhost:5432/xtreme
AUTH_SECRET_KEY=your-secret-key-minimum-32-bytes-long-change-this-in-production
# Obrigatória e independente da AUTH_SECRET_KEY. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
# Nunca versionar o valor; injete-o pelo secret manager em produção.
RSD_ENCRYPTION_KEY=
# Preencha somente durante `uv run python scripts/rotate-rsd-key.py`.
# RSD_ENCRYPTION_KEY_PREVIOUS=
# Hosts HTTPS exatos permitidos para o portal RSD (separados por vírgula).
RSD_ALLOWED_HOSTS=lojas.rsdsistema.com.br
LOG_LEVEL=INFO
LOG_JSON=false
# Origens permitidas em CORS (CSV). Em produção, liste as origens reais do frontend.
CORS_ORIGINS=http://localhost:8000
# Proxies confiaveis para X-Forwarded-For (CSV de IPs ou CIDRs).
# Vazio = ignora X-Forwarded-For e usa o IP do peer.
TRUSTED_PROXY_IPS=
# IPs/CIDRs autorizados pelo uvicorn a definir X-Forwarded-Proto/For.
# Em Docker atras de proxy, use a rede do proxy (ex.: 172.16.0.0/12).
FORWARDED_ALLOW_IPS=
