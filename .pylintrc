[MASTER]
py-version=3.12
jobs=0
persistent=no

[MESSAGES CONTROL]
disable=
    assignment-from-no-return,
    broad-exception-caught,
    cyclic-import,
    import-outside-toplevel,
    invalid-name,
    not-callable,
    unsubscriptable-object,
    too-many-arguments,
    too-many-locals,
    too-many-positional-arguments,
    too-many-return-statements,
    too-few-public-methods,
    trailing-newlines

[FORMAT]
max-line-length=88
