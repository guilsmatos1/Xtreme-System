{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${CODEX_TOKEN_EFFICIENCY_CHILD:-}\" != \"1\" ]; then /Users/guilsmatos/.local/bin/graphify hook-check; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post-tool-use-track-edit.py\"",
            "timeout": 10,
            "statusMessage": "Tracking edits for post-edit checks"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/verify-on-stop.py\"",
            "timeout": 600,
            "statusMessage": "Running Codex finish hooks"
          }
        ]
      }
    ]
  }
}
